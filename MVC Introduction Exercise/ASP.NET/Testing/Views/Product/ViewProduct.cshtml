@model Product

<h3>@Model.Name Information</h3><!--Notice how there's no foreach loop used here, like it was implemented in the index.cshtml file.-->

<table class="table"><!--So, why were we able to erase all of the previous code here in the ViewProduct cshtml file for just viewing all of our products, but we're still keeping such for updating and viewing individual products?-->
    <tr>
        <th>Product ID</th>
        <th>Name</th>
        <th>Price</th>
        <th>Category ID</th>
        <th>On Sale</th>
        <th>StockLevel</th>
    </tr>
    <tr>
        <td>@Model.ProductID</td>
        <td>@Model.Name</td>
        <td>@Model.Price</td>
        <td>@Model.CategoryID</td>
        <td>@Model.OnSale</td>
        <td>@Model.StockLevel</td>
    </tr>
</table><!--Don't even have to start a new page to load all of the changes made so far -- if a page featuring all of this programming is already open on your local host server, then just save the chnages made here in VSC, and refresh that page.-->

<div style="display: block">
    <a href="/Product/UpdateProduct/@Model.ProductID">Update this Product</a>
</div>

<div style="display: block">

    @using (Html.BeginForm("DeleteProduct", "Product", "Post"))
    {
        <input type="hidden" asp-for="ProductID" value="@Model.ProductID" />
        <input type="submit" onclick="return confirm('Are you sure?')" value="Delete this product" /><!--A prompt that queires whether or not the user isi sure they wish to delete a product.-->
    }
</div>